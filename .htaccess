# Kind Commodities Ltd htaccess Configuration

# Prevent directory listings
Options -Indexes

# Block direct access to Backend directory files from web
RewriteEngine On
RewriteRule ^Backend/config/ - [F,L]
RewriteRule ^Backend/includes/ - [F,L]

# Block root-level utility/setup scripts from web access (security)
RewriteRule ^update_admin_password\.php$ - [F,L]
RewriteRule ^CPANEL_DATABASE_CONFIG\.php$ - [F,L]
RewriteRule ^complete_data_import\.php$ - [F,L]
RewriteRule ^import_data\.php$ - [F,L]

# Serve favicon from Frontend images directory (avoids PHP overhead / 404)
RewriteRule ^favicon\.ico$ /Frontend/images/Kind Commodities Ltd Logo_Final_favicon.png [L]

# Admin access through kindadmin (security through obscurity)
RewriteRule ^kindadmin/?$ Frontend/admin/login.php [L]

# Redirect trailing slashes
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Route root requests to Frontend/index.php
RewriteRule ^$ Frontend/index.php [L]

# Clean URL Routing for main public pages pointing to Frontend
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^about$ Frontend/pages/about.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^products$ Frontend/pages/products.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^shop$ Frontend/pages/shop.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^cart$ Frontend/pages/cart.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^checkout$ Frontend/pages/checkout.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^services$ Frontend/pages/services.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^contact$ Frontend/pages/contact.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^faq$ Frontend/pages/faq.php [L]

# Clean URL Routing for Auth Pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^login/?$ Frontend/pages/login.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^register/?$ Frontend/pages/register.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^logout/?$ Frontend/pages/logout.php [L]

# Clean URL Routing for Customer Dashboard
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^dashboard/?$ Frontend/pages/dashboard.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^customer/?$ Frontend/pages/dashboard.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^my-account/?$ Frontend/pages/dashboard.php [L]

# Route Admin URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/?$ Frontend/admin/dashboard.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/customers/?$ Frontend/admin/customers.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/(.*)$ Frontend/admin/$1.php [L]

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
